#!/bin/bash
# Load Graph Relay's exported host rules into the nftables sets that open the SMTP ports
# (inet filter smtp4 / smtp6, see deploy/harden-host.sh). Runs as root from graphrelay-fw.service.
# The allowlist is written by the unprivileged relay, so every line is treated as untrusted:
# only strict IPv4/IPv6 prefix syntax is accepted. The sets are replaced in one nft transaction;
# if nft rejects anything, the previous contents stay.
set -euo pipefail

SRC=${1:-/opt/graphrelay/data/firewall-allowlist.txt}
MAX=10000
v4=()
v6=()

if [[ -f $SRC ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    line=${line//[[:space:]]/}
    [[ -z $line ]] && continue
    if [[ $line =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]]; then
      v4+=("$line")
    elif [[ $line == *:* && $line =~ ^[0-9a-fA-F:.]+/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$ ]]; then
      v6+=("$line")
    else
      echo "graphrelay-fw-sync: ignoring invalid entry: ${line:0:60}" >&2
    fi
  done < <(head -c 1048576 "$SRC")
else
  echo "graphrelay-fw-sync: $SRC not found, closing SMTP to everyone" >&2
fi

if (( ${#v4[@]} + ${#v6[@]} > MAX )); then
  echo "graphrelay-fw-sync: more than $MAX entries, refusing to load" >&2
  exit 1
fi

join() { local IFS=,; echo "$*"; }
{
  echo "flush set inet filter smtp4"
  echo "flush set inet filter smtp6"
  (( ${#v4[@]} )) && echo "add element inet filter smtp4 { $(join "${v4[@]}") }"
  (( ${#v6[@]} )) && echo "add element inet filter smtp6 { $(join "${v6[@]}") }"
  true
} | nft -f -

echo "graphrelay-fw-sync: loaded ${#v4[@]} IPv4 and ${#v6[@]} IPv6 entries"
